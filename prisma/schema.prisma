generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  ENTERPRISE
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  PENDING
}

enum PaymentToken {
  ETH
  USDT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  walletAddress String?   @unique
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  payments      Payment[]
  apiKeys       ApiKey[]
  searches      Search[]
  watchlists    Watchlist[]
  alerts        Alert[]
  savedWallets  SavedWallet[]
  savedTokens   SavedToken[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  plan              SubscriptionPlan   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime          @default(now())
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  paymentWallet     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  subscriptionId  String?
  amount          Float
  token           PaymentToken
  txHash          String?       @unique
  status          PaymentStatus @default(PENDING)
  fromAddress     String?
  toAddress       String?
  usdValue        Float?
  blockNumber     Int?
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  key       String    @unique
  lastUsed  DateTime?
  requests  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Search {
  id        String   @id @default(cuid())
  userId    String?
  query     String
  results   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("searches")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("watchlists")
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  type      String
  target    String
  condition Json
  isActive  Boolean  @default(true)
  triggered Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model SavedWallet {
  id        String   @id @default(cuid())
  userId    String
  address   String
  label     String?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@map("saved_wallets")
}

model SavedToken {
  id        String   @id @default(cuid())
  userId    String
  address   String
  chain     String   @default("ethereum")
  label     String?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address, chain])
  @@map("saved_tokens")
}

// Sample entity data models for the knowledge base
model Wallet {
  id          String   @id @default(cuid())
  address     String   @unique
  ens         String?
  label       String?
  riskScore   Float    @default(0)
  firstSeen   DateTime?
  lastActive  DateTime?
  balanceEth  Float    @default(0)
  txCount     Int      @default(0)
  tags        String[]
  aiSummary   String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("wallets")
}

model Token {
  id            String   @id @default(cuid())
  address       String
  chain         String   @default("ethereum")
  symbol        String
  name          String
  decimals      Int      @default(18)
  totalSupply   String?
  marketCap     Float?
  priceUsd      Float?
  holders       Int?
  riskScore     Float    @default(0)
  launchDate    DateTime?
  aiSummary     String?  @db.Text
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([address, chain])
  @@map("tokens")
}

model Protocol {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  category    String?
  tvl         Float?
  website     String?
  twitter     String?
  github      String?
  riskScore   Float    @default(0)
  aiSummary   String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("protocols")
}

model Founder {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  bio         String?  @db.Text
  twitter     String?
  linkedin    String?
  image       String?
  riskScore   Float    @default(0)
  aiSummary   String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("founders")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String   @db.Text
  coverImage  String?
  author      String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}
